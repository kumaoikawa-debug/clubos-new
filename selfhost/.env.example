# ===== ClubOS NEW 自托管环境变量 =====
# 复制本文件为同目录 .env 后修改

# 运行模式：production = 强制登录 + 安全 Cookie（必填，且必须配合 HTTPS）
CLUBOS_SECURITY_MODE=production

# 数据库文件（容器内路径，已挂载为持久卷）
CLUBOS_DB_PATH=/data/clubos.db

# 平台总后台（/platform）管理员账号
# 首次启动会自动创建；改密码后需重新部署/重启使环境变量生效
CLUBOS_PLATFORM_ADMIN_USER=admin
CLUBOS_PLATFORM_ADMIN_PASS=请把这里换成至少14位的强密码

# Caddy 自动 HTTPS 使用的域名（仅 Docker 方案用到）
DOMAIN=topoutdoor.cn
