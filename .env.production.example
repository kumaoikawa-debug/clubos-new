# v0.25 requires separately provisioned, verified production dependencies.
# Set through a secret store. NEVER commit populated .env files or private keys.
CLUBOS_SECURITY_MODE=production
CLUBOS_DB_PATH=/srv/clubos/production/clubos.sqlite
CLUBOS_PUBLIC_BASE_URL=https://your-clubos.example
CLUBOS_AUTH_SIGNING_KEY=
CLUBOS_COMMERCE_WEBHOOK_SECRET=
COMMERCE_PROVIDER=medusa
MEDUSA_URL=
MEDUSA_ADMIN_TOKEN=
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
MEDUSA_SHIPPING_PROFILE_ID=
MEDUSA_SALES_CHANNEL_ID=
MEDUSA_STOCK_LOCATION_ID=
MOCK_AI=0
# 平台统一大模型接入：主用 DeepSeek，备用 通义千问（图片理解 / 容灾）。
# 密钥只存在于平台侧，绝不发给俱乐部；俱乐部按任务消耗 AI Credits。
AI_PRIMARY_ENABLED=1
AI_PRIMARY_PRESET=deepseek
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=deepseek-chat
AI_SECONDARY_ENABLED=1
AI_SECONDARY_PRESET=qwen
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=qwen-plus
AI_SECONDARY_VISION_MODEL=qwen-vl-max
AI_ALLOW_FAILOVER=1
# 可选：平台成本观测（元 / 每百万 token），按 AI_USD_CNY_RATE 折算
AI_DEEPSEEK_INPUT_CNY_PER_1M=0
AI_DEEPSEEK_OUTPUT_CNY_PER_1M=0
AI_QWEN_INPUT_CNY_PER_1M=0
AI_QWEN_OUTPUT_CNY_PER_1M=0
AI_USD_CNY_RATE=7.2
# 也可改为在总平台「AI 模型接入」中在线配置；平台配置优先于环境变量。
