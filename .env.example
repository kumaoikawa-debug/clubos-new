# ClubOS NEW — 平台统一大模型接入（Platform AI Gateway）
#
# 产品策略（必须遵守）：
#   1. 大模型只由【总平台】接入，密钥只存在平台侧；俱乐部没有任何模型配置入口；
#   2. 平台把真实调用成本折算为 AI Credits 发放给俱乐部；
#   3. 各端俱乐部按任务消耗 Credits 使用生成能力。
# AI Credits 只决定计费与授权，绝不改变模型质量、上下文长度或图片数量。
#
# 中国大陆部署默认：主用 DeepSeek（文本推理），备用 通义千问（视觉/通用）。
# 两家均为 OpenAI 兼容端点，可直接使用下方 base_url。
MOCK_AI=1
# 运行模式（mock / live）由总平台后台「AI 模型接入」控制，保存即生效、无需重启：
#   后台未设置时沿用上面的 MOCK_AI；后台切到「真实调用」会直接覆盖 MOCK_AI。
#   生产环境（CLUBOS_SECURITY_MODE=production）禁止切回 mock。
AI_ALLOW_FAILOVER=1
AI_TIMEOUT_SECONDS=240
AI_TEMPERATURE=0.8
# 是否让模型请求读取环境变量里的 HTTP_PROXY/HTTPS_PROXY/NO_PROXY。
# 默认 0（直连）：服务器上残留的代理变量会让模型请求被无意义的代理接管，
# 典型报错是 ProxyError: 502 Bad Gateway。确需经代理出网时再设为 1。
AI_TRUST_ENV=0

# 主用 Provider：deepseek | qwen | openai | custom
AI_PRIMARY_ENABLED=1
AI_PRIMARY_PRESET=deepseek
AI_PRIMARY_NAME=primary
# 留空则使用 PRESET 的官方端点（DeepSeek: https://api.deepseek.com/v1/chat/completions）
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=deepseek-chat
# 主用若具备视觉能力可填（如 qwen-vl-max）；留空表示主用不处理图片任务
AI_PRIMARY_VISION_MODEL=

# 备用 Provider（默认 通义千问：承担图片理解，并作为主用的显式容灾）
AI_SECONDARY_ENABLED=1
AI_SECONDARY_PRESET=qwen
AI_SECONDARY_NAME=secondary
# 留空则使用官方端点（DashScope 兼容模式）
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=qwen-plus
AI_SECONDARY_VISION_MODEL=qwen-vl-max

# 可选：按任务覆盖模型。留空则用对应 Provider 的默认模型。
AI_MODEL_DETAIL=
AI_MODEL_WECHAT=
AI_MODEL_XHS=
AI_MODEL_POSTER=
AI_MODEL_RECAP=
# 任意 Provider 图片任务的统一覆盖（留空则用该 Provider 的视觉模型）
AI_VISION_MODEL=

# 可选：平台成本观测。填厂商官方报价（元 / 每百万 token），按 AI_USD_CNY_RATE 折成 USD 记账。
# 仅用于平台毛利观测，绝不影响前台 Credits 定价与模型质量。
AI_DEEPSEEK_INPUT_CNY_PER_1M=0
AI_DEEPSEEK_OUTPUT_CNY_PER_1M=0
AI_QWEN_INPUT_CNY_PER_1M=0
AI_QWEN_OUTPUT_CNY_PER_1M=0
AI_USD_CNY_RATE=7.2

# 以上配置也可在总平台「AI Credits → AI 模型接入」中在线维护；平台配置优先于本文件。
# v0.1 兼容：未显式配置 AI_PRIMARY_* 时，LLM_* 仍可生效。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Commerce adapter
# local = runnable demo using SQLite
# medusa = ClubOS uses the Medusa v2 sidecar for commerce primitives
COMMERCE_PROVIDER=local
MEDUSA_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_TOKEN=
# bearer = admin JWT; api-key = Medusa secret API key (Authorization: Basic ...)
MEDUSA_ADMIN_AUTH_TYPE=bearer
MEDUSA_REGION_ID=
# Activity checkout never enters Medusa. The adapter below is Gear-only.
# Used by Medusa order.placed subscriber -> ClubOS callback.
CLUBOS_COMMERCE_WEBHOOK_SECRET=change-me

# v0.15 Payment Providers
# Browser return URL is never trusted as payment success; only signed provider callbacks finalize payment.
CLUBOS_PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_HTTP_TIMEOUT_SECONDS=20

# Payment accounts store only provider/channel/merchant/app/credential_ref in DB.
# Private keys / APIv3 keys stay in env/secret manager using credential_ref.
# Example credential_ref: club_1_wechat
# PAYMENT_CRED_CLUB_1_WECHAT_SERIAL_NO=
# PAYMENT_CRED_CLUB_1_WECHAT_PRIVATE_KEY_FILE=/run/secrets/wechat_merchant_private_key.pem
# PAYMENT_CRED_CLUB_1_WECHAT_API_V3_KEY=
# PAYMENT_CRED_CLUB_1_WECHAT_PLATFORM_PUBLIC_KEY_FILE=/run/secrets/wechatpay_public_key.pem
#
# Example credential_ref: platform_alipay
# PAYMENT_CRED_PLATFORM_ALIPAY_PRIVATE_KEY_FILE=/run/secrets/alipay_app_private_key.pem
# PAYMENT_CRED_PLATFORM_ALIPAY_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/alipay_public_key.pem
# PAYMENT_CRED_PLATFORM_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# v0.16 Medusa gear commerce runtime
MEDUSA_SHIPPING_PROFILE_ID=sp_xxx
MEDUSA_SALES_CHANNEL_ID=sc_xxx
MEDUSA_STOCK_LOCATION_ID=sloc_xxx
MEDUSA_CURRENCY_CODE=cny

# Gear checkout only: physical shipping + verified external-payment mirroring
MEDUSA_DEFAULT_SHIPPING_OPTION_ID=so_xxx
MEDUSA_INTERNAL_PAYMENT_PROVIDER_ID=pp_system_default
