__pycache__/
*.pyc
*.db
*.sqlite*
.env
services/medusa/.env
services/medusa/.clubos-runtime.json
services/medusa/node_modules/
services/medusa/.medusa/
.DS_Store
# 运行时上传产物（体积大，由上传动作再生，不随仓库分发）
static/uploads/*/*/
# 本地版本快照（改动前备份，仅供本机回滚）
versions/
outputs/
clubos-*-smoke-*/

# ── #892 上线前安全加固（2026-11-13）─────────────────────────────
# 环境变量变体：只忽略真实配置，保留所有 *.example / *.template 模板
.env.local
.env.production
.env.development
.env.test
.env.*.local
# 私钥材料，绝不入库
*.pem
*.key
*.p12
*.pfx
# SQLite sidecar：含未提交事务数据，误 git add -A 会入库
*.db-journal
*.db-wal
*.db-shm
# static/ 由 app.mount 直接对外服务，任何 .db/.env 落在这里都可被匿名下载
# （2026-11-13 线上实证 HTTP 200 / 1875968 bytes / SQLite format 3）
static/versions/
static/uploads/**
